diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..fffffff
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -1,24 +1,30 @@
 name: CI

-on: [push]
+on:
+  push:
+    branches: [main, mrkernel-exynos2200]
+  pull_request:
+    branches: [main]

 jobs:
   build:
     runs-on: ubuntu-latest
+    strategy:
+      matrix:
+        gcc: [10,11,12]
+        arch: [arm64]

     steps:
     - uses: actions/checkout@v3
     - name: Setup toolchain
       uses: msys2/setup-msys2@v2
       with:
         update: true
+    - name: Install cross compiler
+      run: pacman -S --noconfirm aarch64-linux-gnu-gcc
     - name: Build mrkernel
       run: |
         make O=out mrkernel_defconfig ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu-;
         make -j$(nproc) O=out ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu-
