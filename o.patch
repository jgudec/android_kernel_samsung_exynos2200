diff --git a/Makefile b/Makefile
index abcdef1..9999999 100644
--- a/Makefile
+++ b/Makefile
@@ -1,7 +1,18 @@
 KERNEL_NAME := mrkernel_exynos2200
 BRAND := mrkernel

+## Size optimizations
+# Use LTO, optimize for size, disable debug
+KBUILD_CFLAGS += -Os -flto -fdata-sections -ffunction-sections
+KBUILD_AFLAGS += -Os -flto
+KBUILD_LDFLAGS += -Wl,--gc-sections -Wl,--strip-debug -flto
+
 TARGET_ARCH := arm64
 CROSS_COMPILE := aarch64-linux-gnu-

+# Post-build stripping and compression
+post-build:
+   arm64-linux-gnu-strip --strip-unneeded $(O)/vmlinux
+   mkimage -A arm64 -O linux -T kernel -C lzma -a 0x40000000 -e 0x40000000 -n "mrkernel" -d $(O)/vmlinux $(O)/Image.lzma
+   @echo "Ready kernel size: $(shell ls -lh $(O)/Image.lzma | awk '{print $$5}')"
+
 all:
 	$(MAKE) $(KBUILD_OPTIONS)
diff --git a/.config b/.config
index 89abcde..aaaaaaa 100644
--- a/.config
+++ b/.config
@@ -1,10 +1,15 @@
 CONFIG_LOCALVERSION="-mrkernel"
-CONFIG_DEBUG_INFO=y
+CONFIG_DEBUG_INFO=n
-CONFIG_MRKERNEL_FEATURES=y
+CONFIG_MRKERNEL_FEATURES=y
+CONFIG_EMBEDDED=y
+CONFIG_EMBEDDED_LTO=y
+
 # Scheduler
 CONFIG_SCHED_CORE=y
+
+## Disable debug options to reduce size
+CONFIG_DEBUG_KERNEL=n
+CONFIG_KALLSYMS=n
 CONFIG_LRU_GEN=y
 CONFIG_ZRAM=y
 CONFIG_ZRAM_WRITEBACK=y
diff --git a/arch/arm64/configs/mrkernel_defconfig b/arch/arm64/configs/mrkernel_defconfig
index 2222222..bbbbbbb 100644
--- a/arch/arm64/configs/mrkernel_defconfig
+++ b/arch/arm64/configs/mrkernel_defconfig
@@ -1,8 +1,8 @@
 CONFIG_LOCALVERSION="-mrkernel"
 CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
-CONFIG_DEBUG_KERNEL=y
+CONFIG_DEBUG_KERNEL=n
 CONFIG_SCHED_CORE=y
